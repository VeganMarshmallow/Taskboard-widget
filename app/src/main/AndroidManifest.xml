<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Network-constrained jobs need it (required from Android 14), and so does the offline check. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Required for persisted jobs: a pending retry survives a reboot and runs once the network is up. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Merge all (#57): a notification when a run finishes or stops. Asked for when a run starts. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- No backup or device transfer: the GitHub token must never leave this device. -->
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Taskboard">

        <activity
            android:name=".setup.SetupActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- The New task form, opened from the widget's + button. -->
        <activity
            android:name=".newtask.NewTaskActivity"
            android:exported="false"
            android:label="@string/task_new_title"
            android:windowSoftInputMode="adjustResize|stateVisible" />

        <!-- Invisible trampoline for list-row taps: opens the issue, or confirms an approval. -->
        <activity
            android:name=".widget.RowActionActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Taskboard.Trampoline" />

        <!-- Task preview: a bottom sheet over the home screen, opened by tapping a task row.
             Rotation and resizing keep the instance, so a running load or approval and its result
             (and an open Approve dialog) survive; the wrap-content sheet simply re-lays out. -->
        <activity
            android:name=".preview.TaskPreviewActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:excludeFromRecents="true"
            android:exported="false"
            android:taskAffinity=""
            android:theme="@style/Theme.Taskboard.Preview"
            android:windowSoftInputMode="adjustResize" />

        <!-- The board filter (#59): a bottom sheet over the home screen, like the preview, opened from the widget. -->
        <activity
            android:name=".filter.FilterActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:taskAffinity=""
            android:theme="@style/Theme.Taskboard.Preview"
            android:windowSoftInputMode="adjustResize|stateHidden" />

        <!-- Exported only because the system must deliver APPWIDGET_UPDATE to it. -->
        <receiver
            android:name=".widget.BoardWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/board_widget_info" />
        </receiver>

        <!-- Refresh/approve actions. Not exported: only this app's PendingIntents can reach it. -->
        <receiver
            android:name=".widget.WidgetActionReceiver"
            android:exported="false" />

        <service
            android:name=".widget.BoardListService"
            android:exported="false"
            android:permission="android.permission.BIND_REMOTEVIEWS" />

        <!-- After an app update, restarts the widget's refresh (#29). Only the system sends this. -->
        <receiver
            android:name=".widget.AppUpdatedReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Runs refreshes, approvals and Merge all runs as JobScheduler jobs (never under a receiver's goAsync). -->
        <service
            android:name=".widget.BoardJobService"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
    </application>
</manifest>
