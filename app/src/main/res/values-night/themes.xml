<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Taskboard" parent="android:Theme.Material.NoActionBar">
        <item name="android:colorAccent">@color/widget_accent</item>
        <item name="android:colorPrimary">@color/widget_accent</item>
    </style>
    <style name="Theme.Taskboard.Preview" parent="android:Theme.Material.Dialog.NoActionBar">
        <item name="android:colorAccent">@color/widget_accent</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowCloseOnTouchOutside">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.InputMethod</item>
    </style>
</resources>
