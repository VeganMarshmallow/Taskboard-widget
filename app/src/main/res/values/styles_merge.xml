<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The merge dialog (task #30): a floating card. Not closed by a stray tap outside. -->
    <style name="Theme.Taskboard.MergeDialog" parent="android:Theme.Material.Light.Dialog.NoActionBar">
        <item name="android:colorAccent">@color/widget_accent</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowCloseOnTouchOutside">false</item>
        <item name="android:backgroundDimEnabled">true</item>
    </style>
</resources>
