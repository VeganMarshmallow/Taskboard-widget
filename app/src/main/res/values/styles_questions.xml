<?xml version="1.0" encoding="utf-8"?>
<!-- The Questions screen (task #82). -->
<resources>
    <style name="QuestionsEmpty">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:textColor">?attr/tbMuted</item>
        <item name="android:textDirection">locale</item>
        <item name="android:textSize">13sp</item>
        <item name="android:visibility">gone</item>
    </style>

    <style name="QuestionTask">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAlignment">viewStart</item>
        <item name="android:textColor">?attr/tbText</item>
        <item name="android:textDirection">firstStrong</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="QuestionLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:textColor">?attr/tbMuted</item>
        <item name="android:textDirection">locale</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="QuestionBody">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:lineSpacingExtra">2dp</item>
        <item name="android:textAlignment">viewStart</item>
        <item name="android:textColor">?attr/tbText</item>
        <item name="android:textDirection">firstStrong</item>
        <item name="android:textSize">14sp</item>
    </style>
</resources>
