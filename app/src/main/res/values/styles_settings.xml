<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Settings (#46): sections split by a hairline, and the segmented theme switch. -->
    <style name="SettingsDivider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:layout_marginTop">24dp</item>
        <item name="android:layout_marginBottom">20dp</item>
        <item name="android:background">@drawable/divider</item>
    </style>
    <style name="SettingsSegment">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:background">@drawable/segment_background</item>
        <item name="android:button">@null</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingHorizontal">12dp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/segment_text</item>
        <item name="android:textSize">15sp</item>
    </style>
</resources>
