<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Taskboard" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:colorAccent">@color/widget_accent</item>
        <item name="android:colorPrimary">@color/widget_accent</item>
    </style>
    <!-- Task preview: a bottom sheet over the home screen. Tapping outside or Back closes it. -->
    <style name="Theme.Taskboard.Preview" parent="android:Theme.Material.Light.Dialog.NoActionBar">
        <item name="android:colorAccent">@color/widget_accent</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowCloseOnTouchOutside">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.InputMethod</item>
    </style>
    <style name="Theme.Taskboard.Trampoline" parent="android:Theme.Translucent.NoTitleBar">
        <item name="android:windowAnimationStyle">@null</item>
    </style>
</resources>
