<?xml version="1.0" encoding="utf-8"?>
<!-- One option of a segmented choice (#46): filled when checked, outlined otherwise. App-only (theme tokens). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/tbPrimary" />
            <corners android:radius="?attr/tbRadiusButton" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke android:width="1dp" android:color="?attr/tbMuted" />
            <corners android:radius="?attr/tbRadiusButton" />
        </shape>
    </item>
</selector>
