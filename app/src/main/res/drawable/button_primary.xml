<?xml version="1.0" encoding="utf-8"?>
<!-- The app's main action (#46): filled with the theme's primary colour; faded while disabled. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#33FFFFFF">
    <item>
        <selector>
            <item android:state_enabled="false">
                <shape android:shape="rectangle">
                    <solid android:color="?attr/tbDivider" />
                    <corners android:radius="?attr/tbRadiusButton" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="?attr/tbPrimary" />
                    <corners android:radius="?attr/tbRadiusButton" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
