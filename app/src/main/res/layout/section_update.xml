<?xml version="1.0" encoding="utf-8"?>
<!-- "App updates" on the main screen. Bound by update/UpdateSection.kt. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/update_section"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/update_card_background"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        style="?attr/tbSectionLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/update_title" />

    <TextView
        android:id="@+id/update_status"
        style="?attr/tbBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/update_check"
            style="?attr/tbButtonSecondary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/update_check" />

        <Button
            android:id="@+id/update_install"
            style="?attr/tbButtonPrimary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="@string/update_install"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        style="?attr/tbCaption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/update_note" />
</LinearLayout>
