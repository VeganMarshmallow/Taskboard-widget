<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/preview_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/preview_sheet_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="10dp"
        android:paddingEnd="20dp"
        android:paddingBottom="12dp">

        <View
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="12dp"
            android:background="@drawable/preview_handle" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/preview_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/tbStatusBackground"
                android:fontFamily="sans-serif-medium"
                android:paddingHorizontal="10dp"
                android:paddingVertical="3dp"
                android:textColor="?attr/tbText"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/preview_number"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="?attr/tbMuted"
                android:textSize="13sp" />

            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <ProgressBar
                android:id="@+id/preview_progress"
                style="@android:style/Widget.Material.ProgressBar.Small"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="@string/loading"
                android:indeterminateTint="?attr/tbMuted"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/preview_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:maxLines="4"
            android:textColor="?attr/tbText"
            android:fontFamily="?attr/tbTitleFont"
            android:textDirection="firstStrong"
            android:textSize="21sp"
            android:textStyle="bold" />

        <io.github.veganmarshmallow.taskboard.preview.FlowLayout
            android:id="@+id/preview_tags"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/preview_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:lineSpacingExtra="2dp"
            android:maxLines="3"
            android:textColor="?attr/tbText"
            android:textDirection="firstStrong"
            android:textSize="14sp" />

        <!-- Claude's latest comment (task #43): one line plus Show more (#46); the sheet scrolls when it is long. -->
        <LinearLayout
            android:id="@+id/preview_claude"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/preview_claude_need"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:background="@drawable/claude_need_background"
                android:orientation="vertical"
                android:paddingHorizontal="12dp"
                android:paddingVertical="8dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/preview_claude_need_label"
                    android:textColor="?attr/tbAccent"
                    android:textDirection="locale"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/preview_claude_need_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:lineSpacingExtra="2dp"
                    android:textAlignment="viewStart"
                    android:textColor="?attr/tbText"
                    android:textDirection="firstStrong"
                    android:textSize="14sp" />
            </LinearLayout>

            <io.github.veganmarshmallow.taskboard.preview.CollapsibleText
                android:id="@+id/preview_claude_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/preview_claude_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:lineSpacingExtra="2dp"
                    android:textAlignment="viewStart"
                    android:textColor="?attr/tbMuted"
                    android:textDirection="firstStrong"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/preview_claude_toggle"
                    style="?attr/tbButtonText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="32dp"
                    android:minWidth="0dp"
                    android:paddingHorizontal="0dp"
                    android:text="@string/preview_show_more"
                    android:textAllCaps="false"
                    android:visibility="gone" />
            </io.github.veganmarshmallow.taskboard.preview.CollapsibleText>
        </LinearLayout>

        <!-- Reply to Claude, and optionally unblock the task (task #44). Bound by ReplyViews. -->
        <LinearLayout
            android:id="@+id/preview_reply"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical"
            android:visibility="gone">

            <EditText
                android:id="@+id/preview_reply_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/reply_input_background"
                android:gravity="top|start"
                android:hint="@string/reply_hint"
                android:importantForAutofill="no"
                android:inputType="textMultiLine|textCapSentences"
                android:maxLines="6"
                android:minLines="2"
                android:paddingHorizontal="12dp"
                android:paddingVertical="8dp"
                android:scrollbars="vertical"
                android:textAlignment="textStart"
                android:textColor="?attr/tbText"
                android:textColorHint="?attr/tbMuted"
                android:textDirection="firstStrong"
                android:textSize="14sp" />

            <CheckBox
                android:id="@+id/preview_reply_unblock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:buttonTint="?attr/tbPrimary"
                android:checked="true"
                android:text="@string/reply_unblock"
                android:textColor="?attr/tbText"
                android:textDirection="locale"
                android:textSize="13sp"
                android:visibility="gone" />

            <!-- Send an in-review task back to work on its PR (task #65). -->
            <CheckBox
                android:id="@+id/preview_reply_request_changes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:buttonTint="@color/widget_accent"
                android:text="@string/reply_request_changes"
                android:textColor="@color/widget_text"
                android:textDirection="locale"
                android:textSize="13sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/preview_reply_message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:paddingHorizontal="12dp"
                android:paddingVertical="8dp"
                android:textSize="13sp"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/preview_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/error_background"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            android:textColor="@color/widget_error_text"
            android:textSize="13sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/preview_approved"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/preview_approved"
            android:textColor="@color/ok"
            android:textSize="13sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/preview_merged"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/preview_merged"
            android:textColor="@color/ok"
            android:textSize="13sp"
            android:visibility="gone" />

        <!--
          #46 round 2: every action on one line. Open on GitHub (a link) takes the room left and
          ellipsizes before anything else would; Send is the reply's (tonal in calm, outlined in ink),
          Approve and Merge are the task's main action (filled). Bound by PreviewViews and ReplyViews.
          If they can't all fit (narrow phone, largest font), ActionRow stacks them, one per line.
        -->
        <io.github.veganmarshmallow.taskboard.preview.ActionRow
            android:id="@+id/preview_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/preview_retry"
                style="?attr/tbButtonText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:minWidth="0dp"
                android:text="@string/preview_retry"
                android:textAllCaps="false"
                android:visibility="gone" />

            <Button
                android:id="@+id/preview_open"
                style="?attr/tbButtonText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="center_vertical|start"
                android:maxLines="1"
                android:minWidth="0dp"
                android:text="@string/preview_open_github"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/preview_reply_send"
                style="@style/Button.Taskboard.Sheet.Secondary"
                android:text="@string/reply_send"
                android:visibility="gone" />

            <Button
                android:id="@+id/preview_approve"
                style="@style/Button.Taskboard.Sheet.Primary"
                android:text="@string/approve"
                android:visibility="gone" />

            <Button
                android:id="@+id/preview_merge"
                style="@style/Button.Taskboard.Sheet.Primary"
                android:text="@string/merge"
                android:visibility="gone" />
        </io.github.veganmarshmallow.taskboard.preview.ActionRow>
    </LinearLayout>
</ScrollView>
