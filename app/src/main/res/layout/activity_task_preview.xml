<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/preview_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/preview_sheet_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="10dp"
        android:paddingEnd="20dp"
        android:paddingBottom="12dp">

        <View
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="12dp"
            android:background="@drawable/preview_handle" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/preview_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/preview_status_background"
                android:paddingHorizontal="10dp"
                android:paddingVertical="3dp"
                android:textColor="@color/status_text"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/preview_number"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="@color/widget_muted"
                android:textSize="13sp" />

            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <ProgressBar
                android:id="@+id/preview_progress"
                style="@android:style/Widget.Material.ProgressBar.Small"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="@string/loading"
                android:indeterminateTint="@color/widget_muted"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/preview_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:maxLines="4"
            android:textColor="@color/widget_text"
            android:textDirection="firstStrong"
            android:textSize="19sp"
            android:textStyle="bold" />

        <io.github.veganmarshmallow.taskboard.preview.FlowLayout
            android:id="@+id/preview_tags"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/preview_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:lineSpacingExtra="2dp"
            android:maxLines="3"
            android:textColor="@color/widget_text"
            android:textDirection="firstStrong"
            android:textSize="14sp" />

        <!-- Claude's latest comment in full (task #43); the sheet scrolls when it is long. -->
        <LinearLayout
            android:id="@+id/preview_claude"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/preview_claude_need"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:background="@drawable/claude_need_background"
                android:orientation="vertical"
                android:paddingHorizontal="12dp"
                android:paddingVertical="8dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/preview_claude_need_label"
                    android:textColor="@color/widget_accent"
                    android:textDirection="locale"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/preview_claude_need_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:lineSpacingExtra="2dp"
                    android:textAlignment="viewStart"
                    android:textColor="@color/widget_text"
                    android:textDirection="firstStrong"
                    android:textSize="14sp" />
            </LinearLayout>

            <io.github.veganmarshmallow.taskboard.preview.CollapsibleText
                android:id="@+id/preview_claude_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/preview_claude_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:lineSpacingExtra="2dp"
                    android:textAlignment="viewStart"
                    android:textColor="@color/widget_muted"
                    android:textDirection="firstStrong"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/preview_claude_toggle"
                    style="@android:style/Widget.Material.Button.Borderless.Colored"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="36dp"
                    android:paddingHorizontal="0dp"
                    android:text="@string/preview_show_more"
                    android:textAllCaps="false"
                    android:visibility="gone" />
            </io.github.veganmarshmallow.taskboard.preview.CollapsibleText>
        </LinearLayout>

        <!-- Reply to Claude, and optionally unblock the task (task #44). Bound by ReplyViews. -->
        <LinearLayout
            android:id="@+id/preview_reply"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical"
            android:visibility="gone">

            <EditText
                android:id="@+id/preview_reply_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/reply_input_background"
                android:gravity="top|start"
                android:hint="@string/reply_hint"
                android:importantForAutofill="no"
                android:inputType="textMultiLine|textCapSentences"
                android:maxLines="6"
                android:minLines="2"
                android:paddingHorizontal="12dp"
                android:paddingVertical="8dp"
                android:scrollbars="vertical"
                android:textAlignment="viewStart"
                android:textColor="@color/widget_text"
                android:textColorHint="@color/widget_muted"
                android:textDirection="firstStrong"
                android:textSize="14sp" />

            <CheckBox
                android:id="@+id/preview_reply_unblock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:buttonTint="@color/widget_accent"
                android:checked="true"
                android:text="@string/reply_unblock"
                android:textColor="@color/widget_text"
                android:textDirection="locale"
                android:textSize="13sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/preview_reply_message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:paddingHorizontal="12dp"
                android:paddingVertical="8dp"
                android:textSize="13sp"
                android:visibility="gone" />

            <Button
                android:id="@+id/preview_reply_send"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_gravity="end"
                android:layout_marginTop="6dp"
                android:background="@drawable/preview_button_background"
                android:minWidth="96dp"
                android:paddingHorizontal="20dp"
                android:stateListAnimator="@null"
                android:text="@string/reply_send"
                android:textAllCaps="false"
                android:textColor="@color/widget_accent_text"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/preview_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/error_background"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            android:textColor="@color/widget_error_text"
            android:textSize="13sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/preview_approved"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/preview_approved"
            android:textColor="@color/ok"
            android:textSize="13sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/preview_merged"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/preview_merged"
            android:textColor="@color/ok"
            android:textSize="13sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/preview_approve"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/preview_button_background"
            android:stateListAnimator="@null"
            android:text="@string/approve"
            android:textAllCaps="false"
            android:textColor="@color/widget_accent_text"
            android:textSize="15sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <Button
            android:id="@+id/preview_merge"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/merge_button_background"
            android:stateListAnimator="@null"
            android:text="@string/merge"
            android:textAllCaps="false"
            android:textColor="@color/status_text"
            android:textSize="15sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/preview_retry"
                style="@android:style/Widget.Material.Button.Borderless.Colored"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/preview_retry"
                android:textAllCaps="false"
                android:visibility="gone" />

            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <Button
                android:id="@+id/preview_open"
                style="@android:style/Widget.Material.Button.Borderless.Colored"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/preview_open_github"
                android:textAllCaps="false" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
