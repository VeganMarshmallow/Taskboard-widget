<?xml version="1.0" encoding="utf-8"?>
<!-- Every step of merging a task's PR (task #30): checking, confirm, merging, and refusals. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/merge_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/merge_dialog_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingTop="20dp"
        android:paddingEnd="22dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/merge_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="?attr/tbText"
                android:textDirection="locale"
                android:textSize="19sp"
                android:textStyle="bold" />

            <ProgressBar
                android:id="@+id/merge_progress"
                style="@android:style/Widget.Material.ProgressBar.Small"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="12dp"
                android:contentDescription="@string/loading"
                android:indeterminateTint="?attr/tbMuted"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/merge_lines"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical|end"
            android:orientation="horizontal"
            tools:ignore="ButtonStyle">

            <Button
                android:id="@+id/merge_secondary"
                style="?attr/tbButtonText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAllCaps="false"
                android:visibility="gone" />

            <Button
                android:id="@+id/merge_primary"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/preview_button_background"
                android:minWidth="96dp"
                android:paddingHorizontal="20dp"
                android:stateListAnimator="@null"
                android:textAllCaps="false"
                android:textColor="?attr/tbOnPrimary"
                android:textSize="15sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
