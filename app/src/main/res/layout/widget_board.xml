<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="@dimen/widget_padding">

    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Title and time share whatever the buttons leave (#28): the buttons keep their size at 180dp and large
             fonts, the time collapses first, then the title ellipsizes. -->
        <LinearLayout
            android:id="@+id/header_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/widget_title"
                android:textColor="@color/widget_text"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/updated"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/never_updated"
                android:textColor="@color/widget_muted"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/update_dot"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="@string/update_dot"
            android:padding="7dp"
            android:src="@drawable/update_dot"
            android:visibility="gone" />

        <!-- #59: opens the filter sheet; the accent icon while a filter is on. -->
        <ImageButton
            android:id="@+id/filter"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/filter"
            android:padding="7dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_filter" />

        <ImageButton
            android:id="@+id/new_task"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/new_task"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_add" />

        <ImageButton
            android:id="@+id/refresh"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/refresh"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_refresh" />
    </LinearLayout>

    <include layout="@layout/widget_tabs" />

    <!-- #59: shown while a filter is on, so it is never a mystery why tasks are missing. The text opens the
         filter sheet; Clear turns the filter off. -->
    <LinearLayout
        android:id="@+id/filter_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/filter_bar_background"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/filter_bar_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:minHeight="32dp"
            android:gravity="center_vertical|start"
            android:paddingStart="10dp"
            android:paddingEnd="4dp"
            android:textColor="@color/widget_header_text"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/filter_bar_clear"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/filter_bar_clear_description"
            android:gravity="center"
            android:maxLines="1"
            android:minHeight="32dp"
            android:paddingHorizontal="10dp"
            android:text="@string/filter_bar_clear"
            android:textColor="@color/widget_accent"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/error"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/error_background"
        android:ellipsize="end"
        android:maxLines="2"
        android:paddingHorizontal="10dp"
        android:paddingVertical="6dp"
        android:textColor="@color/widget_error_text"
        android:textSize="13sp"
        android:visibility="gone" />

    <!-- Merge all (#57): the offer on Needs you, a run's progress, or how it ended. -->
    <LinearLayout
        android:id="@+id/merge_all_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/merge_all_bar_background"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingVertical="4dp"
        android:paddingStart="10dp"
        android:paddingEnd="4dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/merge_all_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/merge_muted_text"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/merge_all_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/merge_background"
            android:maxLines="1"
            android:minHeight="32dp"
            android:gravity="center"
            android:paddingHorizontal="12dp"
            android:text="@string/merge_all"
            android:textColor="@color/status_text"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/board_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:scrollbars="none" />

        <TextView
            android:id="@+id/board_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="@string/loading"
            android:textColor="@color/widget_muted"
            android:textSize="13sp" />
    </FrameLayout>
</LinearLayout>
