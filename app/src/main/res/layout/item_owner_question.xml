<?xml version="1.0" encoding="utf-8"?>
<!-- One of the owner's questions to Claude (task #82), with Claude's answer or the wait. Bound by OwnerQuestionViews. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    android:background="@drawable/update_card_background"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:id="@+id/question_task"
        style="@style/QuestionTask" />

    <TextView
        style="@style/QuestionLabel"
        android:text="@string/questions_you_asked" />

    <TextView
        android:id="@+id/question_text"
        style="@style/QuestionBody" />

    <TextView
        android:id="@+id/question_answer_label"
        style="@style/QuestionLabel"
        android:text="@string/questions_answer" />

    <include layout="@layout/claude_comment" />

    <TextView
        android:id="@+id/question_waiting"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/questions_waiting"
        android:textColor="?attr/tbAccent"
        android:textDirection="locale"
        android:textSize="13sp" />
</LinearLayout>
