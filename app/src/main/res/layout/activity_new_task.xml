<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/task_new_title"
            android:textAppearance="@android:style/TextAppearance.Material.Headline" />

        <TextView
            style="@style/FormLabel"
            android:labelFor="@+id/task_title"
            android:text="@string/task_title_label" />

        <EditText
            android:id="@+id/task_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/task_title_hint"
            android:importantForAutofill="no"
            android:inputType="textCapSentences"
            android:maxLines="3"
            android:textAlignment="viewStart" />

        <TextView
            style="@style/FormLabel"
            android:labelFor="@+id/task_goal"
            android:text="@string/task_goal_label" />

        <EditText
            android:id="@+id/task_goal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top|start"
            android:hint="@string/task_goal_hint"
            android:importantForAutofill="no"
            android:inputType="textMultiLine|textCapSentences"
            android:minLines="3"
            android:textAlignment="viewStart" />

        <TextView
            style="@style/FormLabel"
            android:labelFor="@+id/task_done_when"
            android:text="@string/task_done_when_label" />

        <EditText
            android:id="@+id/task_done_when"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top|start"
            android:hint="@string/task_done_when_hint"
            android:importantForAutofill="no"
            android:inputType="textMultiLine|textCapSentences"
            android:textAlignment="viewStart" />

        <TextView
            style="@style/FormLabel"
            android:labelFor="@+id/task_repo"
            android:text="@string/task_repo_label" />

        <AutoCompleteTextView
            android:id="@+id/task_repo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:completionThreshold="1"
            android:hint="@string/task_repo_hint"
            android:importantForAutofill="no"
            android:inputType="textUri|textNoSuggestions"
            android:maxLines="1"
            android:textDirection="ltr" />

        <TextView
            style="@style/FormLabel"
            android:labelFor="@+id/task_type"
            android:text="@string/task_type_label" />

        <Spinner
            android:id="@+id/task_type"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp" />

        <TextView
            style="@style/FormLabel"
            android:text="@string/task_priority_label" />

        <RadioGroup
            android:id="@+id/task_priority"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checkedButton="@+id/priority_normal"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/priority_normal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/priority_normal" />

            <RadioButton
                android:id="@+id/priority_high"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:minHeight="48dp"
                android:text="@string/priority_high" />

            <RadioButton
                android:id="@+id/priority_low"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:minHeight="48dp"
                android:text="@string/priority_low" />
        </RadioGroup>

        <CheckBox
            android:id="@+id/task_approve"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:minHeight="48dp"
            android:text="@string/task_approve" />

        <TextView
            android:id="@+id/task_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textAppearance="@android:style/TextAppearance.Material.Body1"
            android:textColor="@color/error"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/task_cancel"
                style="@android:style/Widget.Material.Button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/task_cancel" />

            <Button
                android:id="@+id/task_submit"
                style="@android:style/Widget.Material.Button.Colored"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="@string/task_submit" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
